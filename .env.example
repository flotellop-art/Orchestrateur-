ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# === Protection HTTP ===
# Vide = mode local uniquement (127.0.0.1, sans proxy ni tunnel).
# Une cle d'au moins 24 caracteres est OBLIGATOIRE pour un tunnel ou un acces reseau. La saisir aussi
# dans la page /control (onglet Reglages). Generer une cle :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=
# Ecoute locale par defaut. N'utiliser 0.0.0.0 qu'avec API_SECRET_KEY.
ORCHESTRATOR_HOST=127.0.0.1
# Protection contre le DNS rebinding. Ajouter ici le domaine du tunnel.
# Exemples : orchestrateur.example.com ou *.trycloudflare.com
ORCHESTRATOR_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Rate-limit quand la protection est active (par IP) :
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_CLIENTS=4096

# Les audits de chemins locaux sont desactives par defaut. Pour les activer,
# lister les dossiers parents autorises (separateur ; sous Windows, : ailleurs).
# ORCHESTRATOR_TARGET_ROOTS=C:\\Users\\vous\\repos;D:\\travail
ORCHESTRATOR_TARGET_ROOTS=

# === Exécution des agents ===
# docker = vraie séparation recommandée ; local = développement non isolé.
ORCHESTRATOR_DEFAULT_EXECUTION=docker
# Image construite/validée par l'administrateur. Ne jamais laisser un agent la choisir.
ORCHESTRATOR_SANDBOX_IMAGE=orchestrator-sandbox:0.2.0
ORCHESTRATOR_SANDBOX_MEMORY=1g
ORCHESTRATOR_SANDBOX_CPUS=1.0
ORCHESTRATOR_SANDBOX_PIDS=128
ORCHESTRATOR_SANDBOX_TIMEOUT=300
# Autorise uniquement pip/npm, apres application de la politique d'installation.
# Les commandes ordinaires restent toujours en reseau coupe.
ORCHESTRATOR_SANDBOX_ALLOW_INSTALL_NETWORK=true
# Docker bridge permet de publier un port local, mais donne aussi un acces
# sortant a l'application. Ce risque exige donc un choix administrateur separe.
ORCHESTRATOR_SANDBOX_ALLOW_APP_NETWORK=false
# Nombre de tâches pouvant être exécutées en parallèle par la file durable.
ORCHESTRATOR_QUEUE_WORKERS=2

# === Notifications sortantes facultatives ===
# Les secrets restent côté serveur. Une tâche planifiée choisit seulement le
# nom du canal déjà configuré : telegram, slack ou discord.
# Exemple : la configuration ne contient que les NOMS des variables secretes.
# ORCHESTRATOR_MESSAGING_CHANNELS={"equipe":{"type":"slack","webhook_env":"SLACK_WEBHOOK_URL"},"suivi":{"type":"telegram","token_env":"TELEGRAM_BOT_TOKEN","chat_id":"-1001234567890"}}
ORCHESTRATOR_MESSAGING_CHANNELS={}
ORCHESTRATOR_MESSAGING_ALLOWED_CHANNELS=
# TELEGRAM_BOT_TOKEN=
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
