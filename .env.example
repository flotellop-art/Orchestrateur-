ANTHROPIC_API_KEY=sk-ant-your-key-here
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# === Reseau ===
# HOST=127.0.0.1 (defaut) : l'app n'est accessible que depuis CE PC (recommande).
# Pour y acceder depuis d'autres appareils du reseau : HOST=0.0.0.0 -- mais
# definis alors une cle API_SECRET_KEY ci-dessous, sinon l'API est ouverte a tous.
HOST=127.0.0.1
# PORT=8000

# === Protection par cle API (OPTIONNELLE) ===
# Laisser VIDE = aucune protection (l'app reste ouverte, comportement par defaut).
# Pour ACTIVER : generer une cle, la coller ici, puis saisir la MEME cle dans
# la page /control (onglet Reglages). Generer une cle :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SECRET_KEY=
# Rate-limit quand la protection est active (par IP) :
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60
